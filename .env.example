# 网络配置（主网部署：base）
NEXT_PUBLIC_NETWORK=base
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# 合约地址（部署到 Base 主网后，替换为你的实际地址）
NEXT_PUBLIC_CROWD_TOKEN=0x...
NEXT_PUBLIC_FACTORY=0x...
NEXT_PUBLIC_STAKING_POOL=0x...

# The Graph 子图 GraphQL 端点
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_SUBGRAPH_ID/crowdfund-staking-base/v0.0.1

# Pinata API Key（图片上传到 IPFS 用，https://app.pinata.cloud/ 申请）
NEXT_PUBLIC_PINATA_JWT=YOUR_PINATA_JWT

# 仅用于 Hardhat 部署/验证脚本，前端不需要（切勿提交真实私钥）
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY
# Basescan 验证 API Key（https://basescan.org/apis 申请，与 Etherscan 通用）
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
