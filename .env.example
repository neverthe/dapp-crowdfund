# 网络配置（测试网部署时：sepolia）
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY

# 合约地址（已部署到 Sepolia，替换为你自己的部署地址）
NEXT_PUBLIC_CROWD_TOKEN=0x...
NEXT_PUBLIC_FACTORY=0x...
NEXT_PUBLIC_STAKING_POOL=0x...

# The Graph 子图 GraphQL 端点
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_SUBGRAPH_ID/crowdfund-staking-sepolia/v0.0.4

# Pinata API Key（图片上传到 IPFS 用，https://app.pinata.cloud/ 申请）
NEXT_PUBLIC_PINATA_JWT=YOUR_PINATA_JWT

# 仅用于 Hardhat 部署脚本，前端不需要（切勿提交真实私钥）
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY
